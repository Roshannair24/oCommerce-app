{%- comment -%}
  Reusable product card (v2) with colour swatches, badges and quick add.
  Safe to render from any grid (collection, search, featured collection, recommendations).

  Accepts the same parameters as the theme's `card-product` snippet, so grids can swap between them:
    card_product          (required) product object
    media_aspect_ratio    'adapt' | 'portrait' | 'square'          (default: adapt)
    show_vendor           boolean                                   (default: true)
    lazy_load             boolean, false = eager-load the image     (default: true)
    skip_styles           boolean, true = don't re-emit CSS/JS      (default: false)
    quick_add             'none' | 'standard' | 'bulk'              (any value but 'none' shows the add button)
    section_id            string                                    (optional)
    sizes                 img sizes attribute override              (optional)
    max_swatches          number of colour swatches shown           (default: 4)
  Accepted for compatibility but not used by this card: image_shape, show_secondary_image, show_rating, product_view_context.

  Legacy aliases still work: lazy (= lazy_load), show_quick_add (boolean), load_assets (= not skip_styles).
{%- endcomment -%}

{%- if card_product != blank -%}
  {%- liquid
    assign product = card_product
    assign max_sw = max_swatches | default: 4
    assign sizes_attr = sizes | default: '(min-width: 990px) 25vw, 50vw'

    # ---- option flags ----
    assign show_v = true
    if show_vendor == false
      assign show_v = false
    endif

    assign show_qa = true
    if show_quick_add == false or quick_add == 'none'
      assign show_qa = false
    endif

    assign img_loading = 'lazy'
    if lazy_load == false or lazy == false
      assign img_loading = 'eager'
    endif

    assign emit_assets = true
    if skip_styles == true or load_assets == false
      assign emit_assets = false
    endif

    # ---- media ratio ----
    assign media_ratio = null
    case media_aspect_ratio
      when 'portrait'
        assign media_ratio = '2 / 3'
      when 'square'
        assign media_ratio = '1 / 1'
    endcase

    # ---- find the colour option ----
    assign color_option = null
    assign cidx = -1
    for opt in product.options_with_values
      assign oname = opt.name | downcase
      if oname == 'color' or oname == 'colour'
        assign color_option = opt
        assign cidx = forloop.index0
        break
      endif
    endfor

    # ---- pick the initially selected variant (first colour that has an available variant) ----
    assign total_colors = 0
    assign init_idx = -1
    assign init_variant = product.selected_or_first_available_variant
    if color_option != blank
      assign total_colors = color_option.values.size
      for value in color_option.values
        assign vname = value.name | default: value
        assign found = false
        for v in product.variants
          if v.options[cidx] == vname and v.available
            assign found = true
            assign cand = v
            break
          endif
        endfor
        if found
          assign init_idx = forloop.index0
          assign init_variant = cand
          break
        endif
      endfor
      if init_idx == -1
        # every colour is sold out: select the first colour
        assign init_idx = 0
        assign first_name = color_option.values.first.name | default: color_option.values.first
        for v in product.variants
          if v.options[cidx] == first_name
            assign init_variant = v
            break
          endif
        endfor
      endif
    endif

    # ---- how many swatches to render ----
    assign shown = max_sw
    if init_idx >= max_sw
      assign shown = max_sw | plus: 1
    endif
    assign hidden_count = total_colors | minus: shown

    # ---- tags -> badges ----
    assign is_clearance = false
    assign is_final_sale = false
    for t in product.tags
      assign tl = t | downcase | replace: ' ', '-'
      if tl == 'clearance'
        assign is_clearance = true
      elsif tl == 'final-sale' or tl == 'finalsale'
        assign is_final_sale = true
      endif
    endfor

    # ---- initial state ----
    assign product_url = product.url
    assign img = init_variant.featured_image | default: product.featured_image
    assign img_alt = img.alt | default: product.title
    assign has_compare = false
    if init_variant.compare_at_price > init_variant.price
      assign has_compare = true
    endif
  -%}

  {%- if emit_assets -%}
    {{ 'product-card-v2.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'product-card-v2.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <product-card-v2 class="pc{% unless init_variant.available %} is-soldout{% endunless %}">
    <div
      class="pc__media"
      {% if media_ratio %}
        style="--pc-ratio: {{ media_ratio }};"
      {% endif %}
    >
      {%- if img -%}
        <img
          class="pc__img"
          src="{{ img | image_url: width: 428 }}"
          srcset="
            {{ img | image_url: width: 214 }} 214w,
            {{ img | image_url: width: 320 }} 320w,
            {{ img | image_url: width: 428 }} 428w,
            {{ img | image_url: width: 640 }} 640w
          "
          sizes="{{ sizes_attr }}"
          alt="{{ img_alt | escape }}"
          width="{{ img.width }}"
          height="{{ img.height }}"
          loading="{{ img_loading }}"
        >
      {%- else -%}
        <span class="pc__placeholder" data-pc-placeholder>
          {{ 'product-1' | placeholder_svg_tag: 'pc__placeholder-svg' }}
        </span>
      {%- endif -%}

      {%- if is_final_sale -%}
        <span class="pc__badge pc__badge--final pc__badge--corner">Final Sale</span>
      {%- endif -%}

      {%- if color_option -%}
        <div class="pc__swatches">
          {%- for value in color_option.values limit: shown -%}
            {%- assign vname = value.name | default: value -%}
            {%- assign sv = null -%}
            {%- for v in product.variants -%}
              {%- if v.options[cidx] == vname -%}
                {%- assign sv = v -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if sv -%}
              <button
                type="button"
                class="pc__swatch{% if forloop.index0 == init_idx %} is-selected{% endif %}"
                data-pc-swatch
                data-variant-id="{{ sv.id }}"
                data-image="{{ sv.featured_image | image_url: width: 428 }}"
                data-price="{{ sv.price | money }}"
                data-url="{{ product_url }}?variant={{ sv.id }}"
                aria-label="{{ vname | escape }}"
                style="background: {{ value.swatch.color | default: vname }}"
              ></button>
            {%- endif -%}
          {%- endfor -%}
          {%- if hidden_count > 0 -%}
            <a
              class="pc__swatch-more"
              href="{{ product_url }}?variant={{ init_variant.id }}"
              aria-label="{{ hidden_count }} more colors"
            >
              <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true" focusable="false">
                <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if show_qa -%}
        <button
          type="button"
          class="pc__add"
          data-pc-add
          data-variant-id="{{ init_variant.id }}"
          aria-label="Add to cart"
        >
          <svg class="pc__add-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
            <path d="M6.5 8h11l1 12h-13l1-12Z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
            <path d="M9 8V6.5a3 3 0 0 1 6 0V8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <path d="M12 12.5v4M10 14.5h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" fill="none"/>
          </svg>
        </button>
      {%- endif -%}
    </div>

    <div
      class="pc__info"
      style="padding: 0 10px 10px 10px;"
    >
      <div class="pc__badges">
        {%- if is_clearance -%}
          <span class="pc__badge pc__badge--clearance">Clearance</span>
        {%- endif -%}
        <span
          class="pc__badge pc__badge--soldout"
          data-pc-soldout
          {% if init_variant.available %}
            hidden
          {% endif %}
          >Sold out</span
        >
      </div>

      <h3 class="pc__title">
        <a href="{{ product_url }}?variant={{ init_variant.id }}" data-pc-link>{{ product.title | escape }}</a>
      </h3>
      {%- if show_v and product.vendor != blank -%}
        <p class="pc__vendor">{{ product.vendor | escape }}</p>
      {%- endif -%}

      <p class="pc__price" data-pc-price>
        <span class="pc__price-now{% if has_compare %} pc__price-now--sale{% endif %}" data-pc-price-now>
          {{- init_variant.price | money -}}
        </span>
        <s
          class="pc__price-was"
          data-pc-price-was
          {% unless has_compare %}
            hidden
          {% endunless %}
        >
          <span class="pc__sr"></span>
          {%- if has_compare %}{{ init_variant.compare_at_price | money }}{% endif %}
        </s>
      </p>
    </div>
  </product-card-v2>
{%- endif -%}
