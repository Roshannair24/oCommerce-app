{%- liquid
  assign bid = block.id
  assign s = block.settings
  assign form_id = 'NotifyForm-' | append: bid
-%}

<div class="ncard" id="NotifyCard-{{ bid }}">
  {%- if s.background_image != blank or s.caption != blank or s.overlay_text != blank -%}
    <div
      class="ncard__media ncard__media--{{ s.image_ratio | default: 'landscape' }} ncard__media--{{ s.caption_position | default: 'bottom' }}"
      {% if s.background_image != blank %}
        role="img" aria-label="{{ s.background_image.alt | default: s.caption | escape }}"
        style="background-image: url('{{ s.background_image | image_url: width: 1600 }}');"
      {% endif %}
    >
      {%- if s.caption != blank -%}
        <div class="ncard__overlay">
          <p class="ncard__caption">{{ s.caption | escape }}</p>
        </div>
      {%- endif -%}

      {%- if s.overlay_text != blank -%}
        <div class="ncard__text ncard__text--{{ s.overlay_position | default: 'center' }}">
          <p class="ncard__text-content">{{ s.overlay_text | escape | newline_to_br }}</p>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if s.heading != blank -%}
    <h3 class="ncard__heading">{{ s.heading | escape }}</h3>
  {%- endif -%}

  {%- form 'customer', id: form_id, class: 'ncard__form', novalidate: 'novalidate' -%}
    <input type="hidden" name="contact[tags]" value="{{ s.customer_tags | escape }}">

    {%- if form.posted_successfully? -%}
      {%- comment -%} SUCCESS {%- endcomment -%}
      <p class="ncard__msg ncard__msg--success" role="status">{{ s.success_message | escape }}</p>
    {%- else -%}
      <div class="ncard__field">
        <label class="ncard__label" for="{{ form_id }}-email">Email</label>
        <input
          id="{{ form_id }}-email"
          class="ncard__input"
          type="email"
          name="contact[email]"
          value="{{ form.email | escape }}"
          placeholder="{{ s.email_placeholder | escape }}"
          autocomplete="email"
          required
        >
        <button type="submit" name="commit" class="ncard__btn">{{ s.button_label | escape }}</button>
      </div>

      {%- comment -%} ERROR (from Shopify) {%- endcomment -%}
      {%- if form.errors -%}
        <p class="ncard__msg ncard__msg--error" role="alert">
          {%- for field in form.errors -%}
            {%- if field == 'form' -%}
              {{ form.errors.messages[field] }}
            {%- else -%}
              {{ form.errors.translated_fields[field] | capitalize }}
              {{ form.errors.messages[field] }}
            {%- endif -%}
            {%- unless forloop.last %} {% endunless -%}
          {%- endfor -%}
        </p>
      {%- endif -%}
    {%- endif -%}
  {%- endform -%}
</div>

<style>
   #NotifyCard-{{ bid }} {
    box-sizing: border-box;
    border: 1px solid #d9d9d9;
    border-radius: 3px;
      {%- if s.card_bg != blank %}background-color: {{ s.card_bg }};{% endif %}
    padding: {{ s.padding_top | default: 0 }}px {{ s.padding_right | default: 0 }}px {{ s.padding_bottom | default: 0 }}px {{ s.padding_left | default: 0 }}px;
  }












   #NotifyCard-{{ bid }} .ncard__media {
      position: relative; display: flex; flex-direction: column; width: 100%; margin: 0 0 1em;
      background-size: cover; background-position: center; background-repeat: no-repeat; border-radius: 0px; overflow: hidden;
    }
    #NotifyCard-{{ bid }} .ncard__media--landscape { aspect-ratio: 3 / 2; }
    #NotifyCard-{{ bid }} .ncard__media--square { aspect-ratio: 1 / 1; }
    #NotifyCard-{{ bid }} .ncard__media--portrait { aspect-ratio: 2 / 3; }
    #NotifyCard-{{ bid }} .ncard__media--top { justify-content: flex-start; }
    #NotifyCard-{{ bid }} .ncard__media--center { justify-content: center; }
    #NotifyCard-{{ bid }} .ncard__media--bottom { justify-content: flex-end; }
    #NotifyCard-{{ bid }} .ncard__overlay { padding: 1em; color: #fff; background: linear-gradient(transparent, rgba(0, 0, 0, .55)); }
    #NotifyCard-{{ bid }} .ncard__caption { margin: 0; font-weight: 600; }















    #NotifyCard-{{ bid }} .ncard__heading { margin: 0 0 .6em; }
    #NotifyCard-{{ bid }} .ncard__field { display: flex; flex-wrap: wrap; gap: 0; align-items: stretch; }
    #NotifyCard-{{ bid }} .ncard__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    #NotifyCard-{{ bid }} .ncard__input {
      flex: 1 1 200px; min-width: 0; padding: .85em 0; font: inherit;
      border: 0; border-bottom: 1px solid #421802; border-radius: 0px; background: transparent; color: inherit;
    }
    #NotifyCard-{{ bid }} .ncard__btn {
      padding: .85em 1.6em; font: inherit; font-weight: 600; cursor: pointer;
      background: transparent; color: {{ s.button_text_color }}; border: 0; border-bottom: 1px solid #421802; border-radius: 0px;
    }
    #NotifyCard-{{ bid }} .ncard__msg { margin: .8em 0 0; }
    #NotifyCard-{{ bid }} .ncard__msg--error { color: #c62828; }
    #NotifyCard-{{ bid }} .ncard__msg--success { color: #1b7f3b; font-weight: 600; margin: 0; }
    {%- comment -%} Text styling: heading / email input + placeholder / button {%- endcomment -%}
    {%- if s.heading_font != blank -%}{{ s.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if s.input_font != blank -%}{{ s.input_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if s.button_font != blank -%}{{ s.button_font | font_face: font_display: 'swap' }}{%- endif -%}

    #NotifyCard-{{ bid }} .ncard__heading {
      {%- if s.heading_font != blank %} font-family: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }}; font-weight: {{ s.heading_font.weight }}; font-style: {{ s.heading_font.style }};{% endif %}
      {%- if s.heading_size != blank %} font-size: {{ s.heading_size }}px;{% endif %}
      {%- if s.heading_color != blank %} color: {{ s.heading_color }};{% endif %}
    }
    #NotifyCard-{{ bid }} .ncard__input {
      {%- if s.input_font != blank %} font-family: {{ s.input_font.family }}, {{ s.input_font.fallback_families }}; font-weight: {{ s.input_font.weight }}; font-style: {{ s.input_font.style }};{% endif %}
      {%- if s.input_size != blank %} font-size: {{ s.input_size }}px;{% endif %}
    }
    #NotifyCard-{{ bid }} .ncard__input::placeholder {
      {%- if s.input_color != blank %} color: {{ s.input_color }}; opacity: 1;{% endif %}
    }
    #NotifyCard-{{ bid }} .ncard__btn {
      {%- if s.button_font != blank %} font-family: {{ s.button_font.family }}, {{ s.button_font.fallback_families }}; font-weight: {{ s.button_font.weight }}; font-style: {{ s.button_font.style }};{% endif %}
      {%- if s.button_size != blank %} font-size: {{ s.button_size }}px;{% endif %}
    }
    {%- comment -%} Text overlay on the image {%- endcomment -%}
    {%- if s.overlay_font != blank -%}{{ s.overlay_font | font_face: font_display: 'swap' }}{%- endif -%}
    #NotifyCard-{{ bid }} .ncard__text { position: absolute; inset: 0; display: flex; padding: 1em; box-sizing: border-box; pointer-events: none; }
    #NotifyCard-{{ bid }} .ncard__text-content {
      margin: 0; max-width: 100%; line-height: 1.15; overflow-wrap: anywhere;
      color: {{ s.overlay_color | default: '#ffffff' }};
      font-size: {{ s.overlay_size | default: 32 }}px;
      {%- if s.overlay_font != blank %} font-family: {{ s.overlay_font.family }}, {{ s.overlay_font.fallback_families }}; font-weight: {{ s.overlay_font.weight }}; font-style: {{ s.overlay_font.style }};{% endif %}
    }
    #NotifyCard-{{ bid }} .ncard__text--center { align-items: center; justify-content: center; text-align: center; }
    #NotifyCard-{{ bid }} .ncard__text--top { align-items: flex-start; justify-content: center; text-align: center; }
    #NotifyCard-{{ bid }} .ncard__text--bottom { align-items: flex-end; justify-content: center; text-align: center; }
    #NotifyCard-{{ bid }} .ncard__text--top-left { align-items: flex-start; justify-content: flex-start; text-align: left; }
    #NotifyCard-{{ bid }} .ncard__text--top-right { align-items: flex-start; justify-content: flex-end; text-align: right; }
    #NotifyCard-{{ bid }} .ncard__text--bottom-left { align-items: flex-end; justify-content: flex-start; text-align: left; }
    #NotifyCard-{{ bid }} .ncard__text--bottom-right { align-items: flex-end; justify-content: flex-end; text-align: right; }
</style>
