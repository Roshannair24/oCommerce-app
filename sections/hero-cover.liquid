{{ 'section-hero-cover.css' | asset_url | stylesheet_tag }}

<div
  class="hero-cover color-{{ section.settings.color_scheme }}"
  style="
    --hero-height: {{ section.settings.height }}px;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  {%- if section.settings.background_image != blank -%}
    <div class="hero-cover__image">
      {{
        section.settings.background_image
        | image_url: width: 2000
        | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2000'
      }}
    </div>
  {%- endif -%}

  {%- if section.settings.foreground_image != blank -%}
    <div class="hero-cover__foreground">
      {{
        section.settings.foreground_image
        | image_url: width: 1200
        | image_tag: loading: 'eager', sizes: '(min-width: 750px) 50vw, 90vw', widths: '400, 600, 900, 1200'
      }}
    </div>
  {%- endif -%}

  <div class="hero-cover__content hero-cover__content--{{ section.settings.content_position }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="hero-cover__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="hero-cover__buttons">
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero cover",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "foreground_image",
      "label": "Foreground image"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Section height",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "presets": [
    {
      "name": "Hero cover",
      "blocks": [{ "type": "cta-button" }]
    }
  ]
}
{% endschema %}
