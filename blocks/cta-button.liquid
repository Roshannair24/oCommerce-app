{%- if block.settings.button_label != blank -%}
  {%- assign btn_font = block.settings.button_font -%}
  <style>
    {%- if btn_font != blank -%}
      {{ btn_font | font_face: font_display: 'swap' }}
    {%- endif -%}
    #cta-{{ block.id }},
    #cta-{{ block.id }} * {
      {%- if btn_font != blank %}
      font-family: {{ btn_font.family }}, {{ btn_font.fallback_families }} !important;
      font-weight: {{ btn_font.weight }} !important;
      font-style: {{ btn_font.style }} !important;
      {%- endif %}
      font-size: {{ block.settings.button_font_size | default: 16 }}px !important;
    }
  </style>
  <a
    id="cta-{{ block.id }}"
    href="{{ block.settings.button_link | default: '#' }}"
    class="cta-button"
    style="
      {%- if block.settings.button_bg_color != blank -%}
        --button-bg: {{ block.settings.button_bg_color }};
      {%- endif -%}
      {%- if block.settings.button_text_color != blank -%}
        --button-text: {{ block.settings.button_text_color }};
      {%- endif -%}
    "
    {{ block.shopify_attributes }}
  >
    {{ block.settings.button_label }}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "CTA Button",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Button label font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Button label font size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Text color",
      "default": "#ffffff"
    }
  ]
}
{% endschema %}
