{%- liquid
  assign bid = block.id
  assign s = block.settings
-%}

<div
  id="Countdown-{{ bid }}"
  class="cdt"
  data-date="{{ s.end_date | escape }}"
  data-time="{{ s.end_time | escape }}"
  data-offset="{{ s.timezone }}"
  data-on-end="{{ s.on_end }}"
  style="
    --cdt-box: {{ s.box_color }};
    --cdt-box-text: {{ s.box_text_color }};
    --cdt-sep: {{ s.separator_color | default: '#ffffff' }};
    --cdt-h-size: {{ s.heading_size | default: 28 }}px;
    --cdt-sub-size: {{ s.subheading_size | default: 16 }}px;
    --cdt-label-size: {{ s.label_size | default: 13 }}px;
  "
  {{ block.shopify_attributes }}
  hidden
>
  {%- if s.heading != blank -%}
    <h3 class="cdt__heading">{{ s.heading | escape }}</h3>
  {%- endif -%}
  {%- if s.subheading != blank -%}
    <p class="cdt__sub" data-cdt-sub>{{ s.subheading | escape }}</p>
  {%- endif -%}

  <div class="cdt__timer" data-cdt-timer role="timer" aria-label="{{ s.heading | escape }}">
    <div class="cdt__unit"><span class="cdt__digits" data-cdt-days><span class="cdt__digit">0</span><span class="cdt__digit">0</span></span><span class="cdt__label">{{ s.label_days | escape }}</span></div>
    <span class="cdt__sep" aria-hidden="true">:</span>
    <div class="cdt__unit"><span class="cdt__digits" data-cdt-hours><span class="cdt__digit">0</span><span class="cdt__digit">0</span></span><span class="cdt__label">{{ s.label_hours | escape }}</span></div>
    <span class="cdt__sep" aria-hidden="true">:</span>
    <div class="cdt__unit"><span class="cdt__digits" data-cdt-minutes><span class="cdt__digit">0</span><span class="cdt__digit">0</span></span><span class="cdt__label">{{ s.label_minutes | escape }}</span></div>
    <span class="cdt__sep" aria-hidden="true">:</span>
    <div class="cdt__unit"><span class="cdt__digits" data-cdt-seconds><span class="cdt__digit">0</span><span class="cdt__digit">0</span></span><span class="cdt__label">{{ s.label_seconds | escape }}</span></div>
  </div>

  <div class="cdt__ended" data-cdt-ended role="status" hidden>
    <p class="cdt__ended-text">{{ s.ended_message | escape }}</p>
    {%- if s.ended_button_label != blank and s.ended_button_link != blank -%}
      <a class="cdt__btn" href="{{ s.ended_button_link }}">{{ s.ended_button_label | escape }}</a>
    {%- endif -%}
  </div>
</div>

<noscript><style>#Countdown-{{ bid }}[hidden]{display:block !important}</style></noscript>

<style>
  {%- if s.heading_font != blank -%}{{ s.heading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if s.subheading_font != blank -%}{{ s.subheading_font | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if s.label_font != blank -%}{{ s.label_font | font_face: font_display: 'swap' }}{%- endif %}
  #Countdown-{{ bid }} { width: 100%; text-align: center; }
  #Countdown-{{ bid }}[hidden], #Countdown-{{ bid }} [hidden] { display: none !important; }
  #Countdown-{{ bid }} .cdt__heading {
    margin: 0 0 .4em; line-height: 1.2; font-size: calc(var(--cdt-h-size) * .75);
    {%- if s.heading_color != blank %} color: {{ s.heading_color }};{% endif %}
    {%- if s.heading_font != blank %}
    font-family: {{ s.heading_font.family }}, {{ s.heading_font.fallback_families }};
    font-weight: {{ s.heading_font.weight }}; font-style: {{ s.heading_font.style }};
    {%- endif %}
  }
  #Countdown-{{ bid }} .cdt__sub {
    margin: 0 0 1em; opacity: .85; line-height: 1.3; font-size: calc(var(--cdt-sub-size) * .8);
    {%- if s.subheading_color != blank %} color: {{ s.subheading_color }};{% endif %}
    {%- if s.subheading_font != blank %}
    font-family: {{ s.subheading_font.family }}, {{ s.subheading_font.fallback_families }};
    font-weight: {{ s.subheading_font.weight }}; font-style: {{ s.subheading_font.style }};
    {%- endif %}
  }
  @media screen and (min-width: 750px) {
    #Countdown-{{ bid }} .cdt__heading { font-size: var(--cdt-h-size); }
    #Countdown-{{ bid }} .cdt__sub { font-size: var(--cdt-sub-size); }
    #Countdown-{{ bid }} .cdt__label { font-size: var(--cdt-label-size); }
  }
  #Countdown-{{ bid }} { --cdt-tile-w: clamp(28px, 6vw, 46px); --cdt-tile-h: clamp(40px, 8.5vw, 64px); }
  #Countdown-{{ bid }} .cdt__timer { display: flex; flex-wrap: wrap; justify-content: center; align-items: flex-start; gap: clamp(4px, 1.2vw, 10px); }
  #Countdown-{{ bid }} .cdt__unit { display: flex; flex-direction: column; align-items: center; }
  #Countdown-{{ bid }} .cdt__digits { display: flex; gap: clamp(3px, .8vw, 6px); }
  #Countdown-{{ bid }} .cdt__digit {
    display: flex; align-items: center; justify-content: center;
    width: var(--cdt-tile-w); height: var(--cdt-tile-h);
    background: var(--cdt-box); color: var(--cdt-box-text); border-radius: 4px;
    font-size: clamp(1.1rem, 3.2vw, 1.9rem); font-weight: 700; line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  #Countdown-{{ bid }} .cdt__sep {
    display: flex; align-items: center; height: var(--cdt-tile-h); color: var(--cdt-sep);
    font-size: clamp(1.1rem, 3.2vw, 1.9rem); font-weight: 700; line-height: 1;
  }
  #Countdown-{{ bid }} .cdt__label {
    margin-top: .5em; font-size: calc(var(--cdt-label-size) * .85); letter-spacing: .04em; opacity: .9;
    {%- if s.label_color != blank %} color: {{ s.label_color }};{% endif %}
    {%- if s.label_font != blank %}
    font-family: {{ s.label_font.family }}, {{ s.label_font.fallback_families }};
    font-weight: {{ s.label_font.weight }}; font-style: {{ s.label_font.style }};
    {%- endif %}
  }
  #Countdown-{{ bid }} .cdt__ended-text { margin: 0 0 1em; font-weight: 600; }
  #Countdown-{{ bid }} .cdt__btn {
    display: inline-block; padding: .8em 1.6em; border-radius: 6px; text-decoration: none;
    background: var(--cdt-box); color: var(--cdt-box-text); font-weight: 600;
  }
</style>

<script>
  (function () {
    var ROOT_ID = 'Countdown-{{ bid }}';
    var SECTION_ID = '{{ section_id }}';
    var timerId = null;

    function pad(n) { return n < 10 ? '0' + n : String(n); }

    // One tile per digit. Rebuild tiles only when the digit count changes (e.g. 100+ days).
    function setDigits(el, str) {
      if (el.children.length !== str.length) {
        el.textContent = '';
        for (var i = 0; i < str.length; i++) {
          var d = document.createElement('span');
          d.className = 'cdt__digit';
          el.appendChild(d);
        }
      }
      for (var j = 0; j < str.length; j++) {
        if (el.children[j].textContent !== str[j]) el.children[j].textContent = str[j];
      }
    }

    function parseTarget(root) {
      var d = (root.dataset.date || '').trim();       // YYYY-MM-DD
      var t = (root.dataset.time || '00:00').trim();  // HH:MM
      var off = root.dataset.offset || '+00:00';      // e.g. +05:30
      if (!/^\d{4}-\d{2}-\d{2}$/.test(d)) return NaN;
      if (!/^\d{1,2}:\d{2}$/.test(t)) t = '00:00';
      if (t.length === 4) t = '0' + t;
      return new Date(d + 'T' + t + ':00' + off).getTime();
    }

    function init() {
      var root = document.getElementById(ROOT_ID);
      if (!root) return;
      if (timerId) { clearInterval(timerId); timerId = null; }

      var q = function (s) { return root.querySelector(s); };
      var els = {
        d: q('[data-cdt-days]'), h: q('[data-cdt-hours]'),
        m: q('[data-cdt-minutes]'), s: q('[data-cdt-seconds]'),
        timer: q('[data-cdt-timer]'), ended: q('[data-cdt-ended]'), sub: q('[data-cdt-sub]')
      };
      var inEditor = window.Shopify && Shopify.designMode;
      var target = parseTarget(root);

      // Reset to running state (matters on editor re-init)
      els.timer.hidden = false; els.ended.hidden = true;
      if (els.sub) els.sub.hidden = false;

      if (isNaN(target)) {
        root.hidden = !inEditor;
        if (inEditor) {
          els.timer.hidden = true; els.ended.hidden = false;
          els.ended.querySelector('.cdt__ended-text').textContent = 'Set a valid end date (YYYY-MM-DD) in the block settings.';
        }
        return;
      }

      function showEnded() {
        if (timerId) { clearInterval(timerId); timerId = null; }
        // "hide" removes only this block's content, so the column layout stays intact.
        // Never hide in the theme editor, or the merchant can't select the block.
        if (root.dataset.onEnd === 'hide' && !inEditor) { root.hidden = true; return; }
        els.timer.hidden = true;
        if (els.sub) els.sub.hidden = true;
        els.ended.hidden = false;
        root.hidden = false;
      }

      function tick() {
        var diff = target - Date.now();
        if (diff <= 0) { showEnded(); return false; }
        var secs = Math.floor(diff / 1000);
        setDigits(els.d, pad(Math.floor(secs / 86400)));
        setDigits(els.h, pad(Math.floor((secs % 86400) / 3600)));
        setDigits(els.m, pad(Math.floor((secs % 3600) / 60)));
        setDigits(els.s, pad(secs % 60));
        return true;
      }

      if (tick()) {
        root.hidden = false;
        timerId = setInterval(tick, 250); // Date.now() each tick = no drift, survives throttled tabs
      }
    }

    init();
    // Theme editor: section re-renders when a block setting changes.
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === SECTION_ID) init();
    });
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden) init();
    });
  })();
</script>
